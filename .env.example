# ═══════════════════════════════════════════════════════════
# ApplyPilot — Environment Configuration
# Copy this to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════

# LinkedIn Credentials (required)
LINKEDIN_EMAIL=your-email@gmail.com
LINKEDIN_PASSWORD=your-linkedin-password

# Telegram Bot (required for notifications)
# See README for setup: https://github.com/rahgoel2510/applypilot#getting-a-telegram-bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# AI API Key (required for smart scoring + cover letters)
# Get free key at https://openrouter.ai
OPENAI_API_KEY=sk-or-v1-your-openrouter-key

# Dashboard API Key (auto-generated if not set)
# The backend will generate and print one on first start if missing.
# APPLYPILOT_API_KEY=

# Optional: Turso Cloud Database (for dedup sync across devices)
# Only needed if you run on multiple machines and want shared dedup.
# TURSO_URL=
# TURSO_TOKEN=
